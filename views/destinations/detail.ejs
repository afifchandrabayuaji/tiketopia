<section class="max-w-7xl mx-auto px-4 py-8">
  <p class="text-xs text-gray-400 mb-4">
    <a href="/" class="hover:underline">Beranda</a> /
    <a href="/destinations?province=<%= encodeURIComponent(destination.province ? destination.province.name : '') %>" class="hover:underline"><%= destination.province ? destination.province.name : '-' %></a> /
    <span class="text-gray-600"><%= destination.name %></span>
  </p>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Kolom kiri: info destinasi -->
    <div class="lg:col-span-2">
      <h1 class="text-2xl font-bold"><%= destination.name %></h1>
      <p class="text-sm text-gray-500 mt-1">📍 <%= destination.location || '-' %></p>
      <% if (avgRating) { %>
        <p class="text-sm text-yellow-600 mt-1">★ <%= avgRating %> (<%= destination.comments.length %> ulasan)</p>
      <% } %>

      <img src="<%= destination.image || 'https://images.unsplash.com/photo-1596402184320-417e7178b2cd?w=1000' %>" class="w-full h-72 object-cover rounded-xl mt-4" alt="<%= destination.name %>" />

      <div class="grid grid-cols-2 gap-4 mt-6 text-sm">
        <div class="bg-white border border-gray-100 rounded-lg p-4">
          <p class="text-gray-400 text-xs">Lokasi</p>
          <p class="font-medium"><%= destination.location || '-' %></p>
        </div>
        <div class="bg-white border border-gray-100 rounded-lg p-4">
          <p class="text-gray-400 text-xs">Ketinggian</p>
          <p class="font-medium"><%= destination.altitude ? destination.altitude + ' mdpl' : '-' %></p>
        </div>
        <div class="bg-white border border-gray-100 rounded-lg p-4 col-span-2">
          <p class="text-gray-400 text-xs">Jam Buka</p>
          <p class="font-medium"><%= destination.openHours || '-' %></p>
        </div>
      </div>

      <div class="mt-8">
        <h2 class="font-bold text-lg mb-2">Narasi Sejarah</h2>
        <p class="text-sm text-gray-600 whitespace-pre-line"><%= destination.history || '-' %></p>
      </div>

      <div class="grid grid-cols-2 gap-6 mt-8">
        <div>
          <h2 class="font-bold text-lg mb-2">Daftar Flora</h2>
          <ul class="text-sm text-gray-600 list-disc list-inside space-y-1">
            <% (destination.flora || []).forEach(function(f) { %>
              <li><%= f %></li>
            <% }) %>
            <% if (!destination.flora || destination.flora.length === 0) { %>
              <li class="list-none text-gray-400">Belum ada data.</li>
            <% } %>
          </ul>
        </div>
        <div>
          <h2 class="font-bold text-lg mb-2">Daftar Fauna</h2>
          <ul class="text-sm text-gray-600 list-disc list-inside space-y-1">
            <% (destination.fauna || []).forEach(function(f) { %>
              <li><%= f %></li>
            <% }) %>
            <% if (!destination.fauna || destination.fauna.length === 0) { %>
              <li class="list-none text-gray-400">Belum ada data.</li>
            <% } %>
          </ul>
        </div>
      </div>

      <div class="mt-8">
        <h2 class="font-bold text-lg mb-2">Fakta Unik</h2>
        <p class="text-sm text-gray-600 whitespace-pre-line"><%= destination.uniqueFacts || '-' %></p>
      </div>

      <!-- Ulasan -->
      <div class="mt-10" id="ulasan">
        <h2 class="font-bold text-lg mb-4">Ulasan Pengunjung (<%= destination.comments.length %>)</h2>

        <% if (canComment) { %>
          <form action="/destinations/<%= destination.id %>/comments" method="POST" class="bg-white border border-gray-100 rounded-lg p-4 mb-6">
            <p class="text-sm font-medium mb-2">Tulis ulasan Anda</p>
            <div class="flex items-center gap-2 mb-3">
              <label class="text-xs text-gray-500">Rating:</label>
              <select name="rating" class="border border-gray-200 rounded-lg px-2 py-1 text-sm">
                <option value="5">5 - Sangat Bagus</option>
                <option value="4">4 - Bagus</option>
                <option value="3">3 - Cukup</option>
                <option value="2">2 - Kurang</option>
                <option value="1">1 - Buruk</option>
              </select>
            </div>
            <textarea name="content" rows="3" required placeholder="Bagaimana pengalaman Anda di destinasi ini?" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm"></textarea>
            <button type="submit" class="mt-3 bg-green-800 hover:bg-green-900 text-white text-sm font-medium px-5 py-2 rounded-lg">
              Kirim Ulasan
            </button>
          </form>
        <% } else if (currentUser) { %>
          <p class="text-sm text-gray-500 mb-6 bg-gray-50 border border-gray-100 rounded-lg p-4">
            Anda hanya bisa memberi ulasan setelah membeli tiket destinasi ini.
          </p>
        <% } %>

        <div class="space-y-4">
          <% destination.comments.forEach(function(c) { %>
            <div class="border-b border-gray-100 pb-4" id="comment-<%= c.id %>">
              <div class="flex items-center justify-between">
                <div>
                  <p class="font-semibold text-sm"><%= c.user ? c.user.username : 'Pengguna' %></p>
                  <p class="text-xs text-yellow-600">
                    <% for(let i=0;i<5;i++){ %><%= i < c.rating ? '★' : '☆' %><% } %>
                  </p>
                </div>
                <p class="text-xs text-gray-400"><%= new Date(c.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></p>
              </div>

              <p class="text-sm text-gray-600 mt-2 comment-text-<%= c.id %>"><%= c.content %></p>

              <% if (currentUser && (currentUser.id === c.userId || currentUser.role === 'admin')) { %>
                <div class="flex gap-3 mt-2 text-xs">
                  <% if (currentUser.id === c.userId) { %>
                    <button type="button" onclick="document.getElementById('edit-form-<%= c.id %>').classList.toggle('hidden')" class="text-blue-600 hover:underline">Edit</button>
                  <% } %>
                  <form action="/comments/<%= c.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Hapus komentar ini?');">
                    <button type="submit" class="text-red-600 hover:underline">Hapus</button>
                  </form>
                </div>

                <% if (currentUser.id === c.userId) { %>
                  <form id="edit-form-<%= c.id %>" action="/comments/<%= c.id %>?_method=PUT" method="POST" class="hidden mt-3 bg-gray-50 rounded-lg p-3">
                    <select name="rating" class="border border-gray-200 rounded-lg px-2 py-1 text-xs mb-2">
                      <option value="5" <%= c.rating===5?'selected':'' %>>5 - Sangat Bagus</option>
                      <option value="4" <%= c.rating===4?'selected':'' %>>4 - Bagus</option>
                      <option value="3" <%= c.rating===3?'selected':'' %>>3 - Cukup</option>
                      <option value="2" <%= c.rating===2?'selected':'' %>>2 - Kurang</option>
                      <option value="1" <%= c.rating===1?'selected':'' %>>1 - Buruk</option>
                    </select>
                    <textarea name="content" rows="2" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-xs"><%= c.content %></textarea>
                    <button type="submit" class="mt-2 bg-green-800 text-white text-xs font-medium px-4 py-1.5 rounded-lg">Simpan</button>
                  </form>
                <% } %>
              <% } %>
            </div>
          <% }) %>
          <% if (destination.comments.length === 0) { %>
            <p class="text-sm text-gray-400">Belum ada ulasan untuk destinasi ini.</p>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Kolom kanan: beli tiket -->
    <div>
      <div class="bg-white border border-gray-100 rounded-xl p-5 sticky top-20">
        <h2 class="font-bold text-lg mb-4">Beli Tiket</h2>

        <% if (destination.tickets && destination.tickets.length > 0) { %>
          <% const ticket = destination.tickets[0]; %>
          <form action="/tickets/<%= ticket.id %>/buy" method="POST" class="space-y-4">
            <div>
              <label class="text-xs text-gray-500">Tanggal Kunjungan</label>
              <input type="date" name="orderDate" required min="<%= new Date().toISOString().split('T')[0] %>" class="w-full border border-gray-200 rounded-lg px-3 py-2 mt-1 text-sm" />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="text-xs text-gray-500">Dewasa (≥ 12 thn)</label>
                <input type="number" name="quantityAdult" value="1" min="0" class="w-full border border-gray-200 rounded-lg px-3 py-2 mt-1 text-sm" />
              </div>
              <div>
                <label class="text-xs text-gray-500">Anak (3 - 11 thn)</label>
                <input type="number" name="quantityChild" value="0" min="0" class="w-full border border-gray-200 rounded-lg px-3 py-2 mt-1 text-sm" />
              </div>
            </div>
            <div class="border-t border-gray-100 pt-3 flex items-center justify-between text-sm">
              <span class="text-gray-500">Harga Mulai Dari</span>
              <span class="font-bold text-green-800">Rp<%= Number(ticket.price).toLocaleString('id-ID') %></span>
            </div>
            <button type="submit" class="w-full bg-green-800 hover:bg-green-900 text-white font-medium py-2.5 rounded-lg">
              Pesan Sekarang
            </button>
          </form>
        <% } else { %>
          <p class="text-sm text-gray-400">Tiket untuk destinasi ini belum tersedia.</p>
        <% } %>
      </div>
    </div>
  </div>
</section>
